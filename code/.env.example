# Copy to the repository root as `.env` and fill in. Never commit the real file.
#
# Only needed for live model calls. The router produces a complete, validated
# output.csv without it (see "Running without a key" in code/README.md).
GEMINI_API_KEY=

# Optional overrides - see code/router/config.py for the full list.
# ORCHESTRATE_JUDGE_SOURCE=auto
# ORCHESTRATE_JUDGE_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite
# ORCHESTRATE_RPM=10
# ORCHESTRATE_USE_MEDIA=1
