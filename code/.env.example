# Copy to the repository root as `.env` and fill in. Never commit the real file.
#
# Neither key is required: the router produces a complete, validated output.csv
# with no network access at all (see "Running without a key" in code/README.md).

# Primary judge. Stronger reasoner; used first when present.
ANTHROPIC_API_KEY=

# Fallback judge, and the only provider that reads voice notes.
GEMINI_API_KEY=

# Hard USD ceiling for paid calls in one run. The guard refuses any call that
# would breach it, so a retry storm cannot drain a prepaid balance.
# ORCHESTRATE_BUDGET_USD=1.50

# Optional overrides - see code/router/config.py for the full list.
# ORCHESTRATE_JUDGE_SOURCE=auto
# ORCHESTRATE_ANTHROPIC_MODELS=claude-sonnet-4-5-20250929,claude-haiku-4-5-20251001
# ORCHESTRATE_JUDGE_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite
# ORCHESTRATE_USE_MEDIA=1
